# Stellarise Valuation Tool — Environment Variables

# PostgreSQL connection (for Prisma — production only)
DATABASE_URL="postgresql://user:password@localhost:5432/stellarise_valuation"

# Server port
PORT=3001

# Redis connection (for BullMQ worker queues — production only)
REDIS_URL="redis://localhost:6379"

# Bright Data API (for production scraping)
BRIGHT_DATA_API_KEY=""
BRIGHT_DATA_ZONE=""
